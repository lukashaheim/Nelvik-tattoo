@section Styles {
    <link rel="stylesheet" href="~/css/faq.css" asp-append-version="true" />
}

@{
    ViewBag.Title = "FAQ";
    Layout = "_Layout";
}
<div class="faq-bg">
<div class="container faq-container">

<div class="container faq-container">
    <div class="row align-items-start">
        <div class="col text-column">
            <h1>FAQ</h1>

            <h5>Hvor holder dere til?</h5>
            <p>Vi holder til i ...</p>

            <h5>Hvordan booker jeg time?</h5>
            <p>Du kan booke via "Book time"-knappen eller ved å kontakte oss på ...</p>

            <h5>Gjør tatovering vondt?</h5>
            <p>Opplevelsen er forskjellig, men vi forklarer godt hva du kan forvente.</p>

            <h5>Hvordan forbereder jeg meg?</h5>
            <p>Møt uthvilt, spis godt og unngå alkohol før timen.</p>
        </div>

        <div class="col-auto image-column">
            <div class="image-container">
                <img src="Images/Faq.jpg" id="faqImg" />
            </div>
        </div>
    </div>
</div>
</div>
</div>