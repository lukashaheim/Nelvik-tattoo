@model Nelvik_Tattoo.Models.GalleryDesign

@{
    ViewData["Title"] = Model.Title;

    // Build a single list of image paths (strings)
    var images = (Model.Images ?? new List<Nelvik_Tattoo.Models.GalleryDesignImage>())
        .OrderBy(i => i.SortOrder)
        .Select(i => i.ImagePath)
        .Where(p => !string.IsNullOrEmpty(p))
        .Distinct()
        .ToList();

    // Ensure cover image is included too
    if (!string.IsNullOrEmpty(Model.ImagePath) && !images.Contains(Model.ImagePath))
        images.Insert(0, Model.ImagePath);

    var mainImage = images.FirstOrDefault();
}

@section Styles {
    <link rel="stylesheet" href="~/css/gallery-details.css" asp-append-version="true" />
}

<section class="gallery-details container">
    <a asp-controller="Gallery" asp-action="Index" class="btn btn-link mb-3">← Tilbake til galleri</a>

    <div class="row">
        <div class="col-md-6">
            @if (!string.IsNullOrEmpty(mainImage))
            {
                <img id="mainDesignImage"
                     src="@mainImage"
                     alt="@Model.Title"
                     style="width:100%; border-radius:8px;" />
            }
            else
            {
                <div class="text-muted">No image available.</div>
            }

            @if (images.Count > 1)
            {
                <div class="angle-thumbs mt-3">
                    @foreach (var imgPath in images)
                    {
                        <button type="button"
                                class="angle-thumb-btn"
                                onclick="setMainImage('@imgPath')">
                            <img src="@imgPath"
                                 class="angle-thumb-img"
                                 alt="@Model.Title" />
                        </button>
                    }
                </div>
            }
        </div>

        <div class="col-md-6">
            <h1>@Model.Title</h1>

            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <p class="mt-3">@Model.Description</p>
            }

            <p class="mt-3">
                <strong>Type motiv:</strong>
                @(Model.IsFlash ? "Flash (til salgs)" : "Tidligere motiv")
            </p>

            @if (Model.IsFlash && Model.Price.HasValue)
            {
                <p class="mt-2">
                    <strong>Pris:</strong> @Model.Price kr
                </p>
            }
        </div>
    </div>
</section>

@section Scripts {
    <script>
        function setMainImage(src) {
            const main = document.getElementById('mainDesignImage');
            if (main) main.src = src;
        }
    </script>
}
