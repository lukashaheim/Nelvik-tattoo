@using System.Globalization
@using System.Linq
@using Nelvik_Tattoo.Models
@model IEnumerable<Nelvik_Tattoo.Models.GalleryDesign>

@{
    ViewData["Title"] = "Gallery";

    // Placements from controller
    var placements = ViewBag.Placements as IEnumerable<string> ?? Enumerable.Empty<string>();
    string? selectedPlacement = ViewBag.SelectedPlacement as string;

    // FLASH ITEMS
    var flashes = ViewBag.Flashes as IEnumerable<GalleryDesign>
                  ?? Enumerable.Empty<GalleryDesign>();

    // Sorting from query string (?sort=newest / ?sort=oldest)
    var sort = Context.Request.Query["sort"].ToString();
    bool sortNewest = string.IsNullOrEmpty(sort) || sort == "newest";
    bool sortOldest = sort == "oldest";

    // PREVIOUS WORK (grid) – SORTABLE
    var previousItems = Model;

    previousItems = sortOldest
        ? previousItems.OrderBy(m => m.Id)
        : previousItems.OrderByDescending(m => m.Id);
}

@section Styles {
    <link rel="stylesheet" href="~/css/gallery.css" asp-append-version="true" />
}

<section class="gallery-page container">
    <h1>@ViewData["Title"]</h1>

    <!-- FLASH-STRIPE -->
    <div class="row mb-3">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <h2 class="mb-0">Available Flash Designs</h2>
            <a asp-controller="Gallery"
               asp-action="Flashes"
               class="btn btn-outline-light">
                See All Flash
            </a>
        </div>
    </div>

    <div class="flash-scroll-wrapper position-relative">

        <!-- Left arrow -->
        <button type="button"
                class="flash-arrow flash-arrow-left btn btn-outline-light btn-sm">
            <i class="bi bi-chevron-left"></i>
        </button>

        <!-- Existing horizontal scroll container -->
        <div class="flash-scroll">
            @foreach (var flash in flashes)
            {
                // Build list of image paths: extra images + cover
                var imgs = (flash.Images ?? new List<GalleryDesignImage>())
                    .OrderBy(i => i.SortOrder)
                    .Select(i => i.ImagePath)
                    .Where(p => !string.IsNullOrEmpty(p))
                    .Distinct()
                    .ToList();

                if (!string.IsNullOrEmpty(flash.ImagePath) && !imgs.Contains(flash.ImagePath))
                    imgs.Insert(0, flash.ImagePath);

                var firstImg = imgs.FirstOrDefault() ?? flash.ImagePath;
                var dataImages = string.Join("|", imgs);

                <a asp-controller="Gallery"
                   asp-action="Details"
                   asp-route-id="@flash.Id">
                    <img class="gallery-hover-cycle"
                         src="@firstImg"
                         data-images="@dataImages"
                         alt="@flash.Title" />
                </a>
            }
        </div>

        <!-- Right arrow -->
        <button type="button"
                class="flash-arrow flash-arrow-right btn btn-outline-light btn-sm">
            <i class="bi bi-chevron-right"></i>
        </button>

    </div>

    <!-- PREVIOUS WORK -->
    <h2 class="mt-4">Previous Work</h2>

    <!-- SORT + FILTER ON SAME ROW -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mt-4 mb-4">

        <!-- SORT LEFT -->
        <div class="gallery-filter d-flex align-items-center gap-2">
            <span class="fw-normal">Sort by:</span>

            <a asp-action="Index"
               asp-route-sort="newest"
               asp-route-placement="@selectedPlacement"
               class="btn btn-sm @(sortNewest ? "btn" : "btn-outline-light")">
                Newest
            </a>

            <a asp-action="Index"
               asp-route-sort="oldest"
               asp-route-placement="@selectedPlacement"
               class="btn btn-sm @(sortOldest ? "btn" : "btn-outline-light")">
                Oldest
            </a>
        </div>

        <!-- FILTER RIGHT -->
        <div class="gallery-filter d-flex align-items-center gap-2">
            <span class="fw-normal">Filter by body placement:</span>

            <a asp-action="Index"
               asp-route-sort="@(sortNewest ? "newest" : "oldest")"
               class="btn btn-sm @(selectedPlacement == null ? "btn" : "btn-outline-light")">
                All
            </a>

            @foreach (var place in placements)
            {
                <a asp-action="Index"
                   asp-route-placement="@place"
                   asp-route-sort="@(sortNewest ? "newest" : "oldest")"
                   class="btn btn-sm @(selectedPlacement == place ? "btn" : "btn-outline-light")">
                    @CultureInfo.CurrentCulture.TextInfo.ToTitleCase(place.ToLower())
                </a>
            }
        </div>
    </div>

    <div class="gallery-grid">
        @foreach (var item in previousItems)
        {
            // Build list of image paths: extra images + cover
            var imgs = (item.Images ?? new List<GalleryDesignImage>())
                .OrderBy(i => i.SortOrder)
                .Select(i => i.ImagePath)
                .Where(p => !string.IsNullOrEmpty(p))
                .Distinct()
                .ToList();

            if (!string.IsNullOrEmpty(item.ImagePath) && !imgs.Contains(item.ImagePath))
                imgs.Insert(0, item.ImagePath);

            var firstImg = imgs.FirstOrDefault() ?? item.ImagePath;
            var dataImages = string.Join("|", imgs);

            <a asp-controller="Gallery"
               asp-action="Details"
               asp-route-id="@item.Id"
               class="gallery-item no-title">
                <img class="gallery-hover-cycle"
                     src="@firstImg"
                     data-images="@dataImages"
                     alt="@item.Title" />
            </a>
        }
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // -------- Flash arrows (your existing code) --------
            const container = document.querySelector(".flash-scroll");
            const leftBtn = document.querySelector(".flash-arrow-left");
            const rightBtn = document.querySelector(".flash-arrow-right");

            if (container && leftBtn && rightBtn) {
                const firstItem = container.querySelector("a");
                let step = 200; // fallback

                if (firstItem) {
                    const itemRect = firstItem.getBoundingClientRect();
                    const styles = window.getComputedStyle(container);
                    const gap = parseFloat(styles.columnGap || styles.gap || "0");
                    step = itemRect.width + gap;
                }

                leftBtn.addEventListener("click", function () {
                    container.scrollBy({ left: -step, behavior: "smooth" });
                });

                rightBtn.addEventListener("click", function () {
                    container.scrollBy({ left: step, behavior: "smooth" });
                });
            }
            
            const INTERVAL_MS = 700;
            const HOLD_DELAY_MS = 180;

            function parseImages(el) {
                const raw = el.dataset.images || "";
                const arr = raw.split("|").map(s => s.trim()).filter(Boolean);
                if (arr.length) return arr;

                const src = el.getAttribute("src");
                return src ? [src] : [];
            }

            function startCycle(imgEl) {
                const images = parseImages(imgEl);
                if (images.length <= 1) return;

                stopCycle(imgEl, false);

                let idx = 0;
                const timer = setInterval(() => {
                    idx = (idx + 1) % images.length;
                    imgEl.src = images[idx];
                }, INTERVAL_MS);

                imgEl.dataset.cycleTimer = String(timer);
            }

            function stopCycle(imgEl, reset = true) {
                const t = imgEl.dataset.cycleTimer;
                if (t) {
                    clearInterval(Number(t));
                    delete imgEl.dataset.cycleTimer;
                }

                if (reset) {
                    const images = parseImages(imgEl);
                    if (images.length) imgEl.src = images[0];
                }
            }

            document.querySelectorAll("img.gallery-hover-cycle").forEach(imgEl => {
                // Desktop hover
                imgEl.addEventListener("mouseenter", () => startCycle(imgEl));
                imgEl.addEventListener("mouseleave", () => stopCycle(imgEl, true));

                // Mobile: press and hold (pointer events)
                let holdTimer = null;

                imgEl.addEventListener("pointerdown", () => {
                    holdTimer = setTimeout(() => startCycle(imgEl), HOLD_DELAY_MS);
                });

                const cancelHold = () => {
                    if (holdTimer) {
                        clearTimeout(holdTimer);
                        holdTimer = null;
                    }
                    stopCycle(imgEl, true);
                };

                imgEl.addEventListener("pointerup", cancelHold);
                imgEl.addEventListener("pointercancel", cancelHold);
                imgEl.addEventListener("pointerleave", cancelHold);
            });
        });
    </script>
}
