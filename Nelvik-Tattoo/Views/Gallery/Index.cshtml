@model IEnumerable<GalleryDesign>

@{
    ViewData["Title"] = "Gallery";
}

@section Styles {
    <link rel="stylesheet" href="~/css/gallery.css" asp-append-version="true" />
}

<section class="gallery-page container">
    <h1>@ViewData["Title"]</h1>

    <div class="gallery-grid">
        @foreach (var item in Model.Where(m => !m.IsFlash))
        {
            <a asp-controller="Gallery"
               asp-action="Details"
               asp-route-id="@item.Id"
               class="gallery-item">

                <img src="@item.ImagePath"
                     alt="@item.Title"
                     class="gallery-img" />
            </a>
        }
    </div>
</section>

<section class="flash-section">
    <div class="flash-header">
        <h2>Flash tattoos</h2>
        <a asp-controller="Gallery"
           asp-action="Flashes"
           class="flash-link">View flash tattoos →</a>
    </div>

    <div class="flash-scroll">
        @foreach (var item in Model.Where(m => m.IsFlash))
        {
            <a asp-controller="Gallery"
               asp-action="Details"
               asp-route-id="@item.Id">
                <img src="@item.ImagePath"
                     alt="@item.Title"
                     class="flash-img" />
            </a>
        }
    </div>
</section>
