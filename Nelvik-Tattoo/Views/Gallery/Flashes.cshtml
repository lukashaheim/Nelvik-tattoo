@model IEnumerable<GalleryDesign>

@{
    ViewData["Title"] = "Flash Tattoos";
}

@section Styles {
    <link rel="stylesheet" href="~/css/gallery.css" asp-append-version="true" />
}

<section class="gallery-page container">
    <h1>@ViewData["Title"]</h1>

    <p class="text-muted">Klikk på et flash-motiv for å se detaljer og bestille motiv.</p>
    <div class="gallery-grid">
        @foreach (var item in Model.Where(m => m.IsFlash))
        {
            <img src="@item.ImagePath" alt="@item.Title" class="gallery-img" />
        }
    </div>
</section>