@model IEnumerable<GalleryDesign>

@{
    ViewData["Title"] = "Tidligere motiver";
}

@section Styles {
    <link rel="stylesheet" href="~/css/gallery.css" asp-append-version="true" />
}

<section class="gallery-page container">
    <h1>@ViewData["Title"]</h1>

    <p class="text-muted">Dette er tidligere motiver som ikke er tilgjengelige for bestilling.</p>

    <div class="gallery-grid">
        @foreach (var item in Model.Where(m => !m.IsFlash))
        {
            <a asp-controller="Gallery"
               asp-action="Details"
               asp-route-id="@item.Id"
               class="gallery-item">

                <img src="/Images/Gallery/@item.ImagePath" alt="@item.Title" class="gallery-img" />


                <h5 class="mt-2">@item.Title</h5>

            </a>
        }
    </div>
</section>