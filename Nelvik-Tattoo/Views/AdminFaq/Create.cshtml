@model Nelvik_Tattoo.Models.FaqItem
@{
    ViewData["Title"] = "Ny FAQ-post";

}

<h1 class="mb-3">Ny FAQ-post</h1>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label asp-for="Question" class="form-label"></label>
        <input asp-for="Question" class="form-control" />
        <span asp-validation-for="Question" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Answer" class="form-label"></label>
        <textarea asp-for="Answer" class="form-control" rows="6"></textarea>
        <span asp-validation-for="Answer" class="text-danger"></span>
    </div>

    <div class="mb-3" style="max-width:200px;">
        <label asp-for="SortOrder" class="form-label"></label>
        <input asp-for="SortOrder" class="form-control" type="number" />
        <span asp-validation-for="SortOrder" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Lagre</button>
    <a href="/theking/faq" class="btn btn-outline-secondary ms-2">Avbryt</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}