@model Nelvik_Tattoo.Models.AboutPage

@section Styles {
    <link rel="stylesheet" href="~/css/about.css" asp-append-version="true" />
}

@{
    ViewBag.Title = "About Admin";
    Layout = "_Layout";
}

<div class="container about-container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="m-0"></h1>
        <a href="/theking/about/edit" class="btn btn-dark">Edit about page</a>
    </div>

    <div class="row align-items-start">
        <!-- LEFT COLUMN — TEXT -->
        <div class="col text-column">
            <h1>@Model.Title</h1>

            <p>@Model.Body</p>
        </div>

        <!-- RIGHT COLUMN — IMAGE -->
        <div class="col-auto image-column">
            <div class="image-container">
                <img src="@Model.ImagePath"
                     id="aboutImg"
                     alt="About image" />
            </div>
        </div>
    </div>
</div>