@model IEnumerable<Nelvik_Tattoo.Models.Booking>
<link rel="stylesheet" href="css/bookingAdmin.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">


@{
    int page = ViewBag.Page ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<h2>Booking-oversikt</h2>

<form method="get" class="filters">
    Fra: <input id="from" type="text" name="from" value="@ViewBag.From" />
    Til: <input id="to" type="text" name="to" value="@ViewBag.To" />
    <button type="submit">Filter</button>
    <button type="button" onclick="window.location='@Url.Action("Index", "AdminBooking")'">
        Reset
    </button>
</form>

<table class="table table-dark table-striped">
    <thead>
    <tr>
        <th>Dato</th>
        <th>Fra – Til</th>
        <th>Kunde</th>
        <th>Ønsket kontakt metode</th>
        <th>Størrelse</th>
        <th>Design</th>
        <th>Plassering</th>
        <th>Budsjett</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var b in Model)
    {
        <tr style="cursor:pointer;">
            <td data-bs-toggle="collapse" data-bs-target="#details-@b.Id">@b.SelectedDate.ToString("dd.MM.yyyy")</td>
            <td data-bs-toggle="collapse" data-bs-target="#details-@b.Id">@b.SelectedStartTime - @b.SelectedEndTime</td>
            <td>
                <span id="email-@b.Id">@b.Email</span>
                <i class="fa-regular fa-copy copy-icon"
                   onclick="copyText(event, 'email-@b.Id')"
                   title="Kopier e-post"></i>

                <br />

                <span id="phone-@b.Id">@b.Phone</span>
                <i class="fa-regular fa-copy copy-icon"
                   onclick="copyText(event, 'phone-@b.Id')"
                   title="Kopier telefon"></i>
            </td>
            <td data-bs-toggle="collapse" data-bs-target="#details-@b.Id">@(b.PrefferedCM == 1 ? "SMS" : "Email")</td>
            <td data-bs-toggle="collapse" data-bs-target="#details-@b.Id">@(b.Size == 1 ? "Small" : b.Size == 2 ? "Medium" : b.Size == 3 ? "Large" : "XL")</td>
            <td data-bs-toggle="collapse" data-bs-target="#details-@b.Id">@b.Design</td>
            <td data-bs-toggle="collapse" data-bs-target="#details-@b.Id">@b.Placement</td>
            <td data-bs-toggle="collapse" data-bs-target="#details-@b.Id">@b.Budget</td>
        </tr>

        
        <tr class="collapse" id="details-@b.Id">
            <td colspan="10" class="bg-dark p-3">
                <strong>Kommentar:</strong> @b.Comment <br />
                
                <strong>Opplastet bilde:</strong><br />
                @if (!string.IsNullOrEmpty(b.ImagePath))
                {
                    <img src="@Url.Content(b.ImagePath)"
                         alt="Referanse bilde"
                         style="max-width: 200px; border-radius: 6px;" />
                }
                else
                {
                    <span>Ingen bilde lastet opp</span>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
<div style="margin-top:20px;">
    <p class="text-light" style="margin-top:10px;">
        Viser @ViewBag.FromRow-@ViewBag.ToRow av @ViewBag.filteredCount bookinger
    </p>
    
    <div style="display:flex; gap:10px;">
        @if (page > 1)
        {
            <a class="btn btn-secondary" id="prev"
               href="@Url.Action("Index", new { page = page - 1, from = ViewBag.From, to = ViewBag.To })">
                Forrige
            </a>
        }

        @if (page < totalPages)
        {
            <a class="btn btn-secondary" id="next"
               href="@Url.Action("Index", new { page = page + 1, from = ViewBag.From, to = ViewBag.To })">
                Neste
            </a>
        }
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script>
  flatpickr("#from", {
    dateFormat: "Y-m-d",
    allowInput: true
  });

  flatpickr("#to", {
    dateFormat: "Y-m-d",
    allowInput: true
  });

  function copyText(e, id) {
      e.stopPropagation();
      e.preventDefault();

      const text = document.getElementById(id).innerText;

      navigator.clipboard.writeText(text).then(() => {
          showCopied(e.target);
      });
  }

  function showCopied(icon) {
      // Fjern evt eksisterende melding ved samme ikon
      const existing = icon.nextElementSibling;
      if (existing && existing.classList.contains("copied-msg")) {
          existing.remove();
      }

      const msg = document.createElement("span");
      msg.className = "copied-msg";
      msg.innerText = "Kopiert";

      // 🔑 legg meldingen rett etter ikonet
      icon.insertAdjacentElement("afterend", msg);

      setTimeout(() => {
          msg.remove();
      }, 1200);
  }

</script>
