@model IEnumerable<Nelvik_Tattoo.Models.Booking>

<h2>Booking-oversikt</h2>

<form method="get" class="filters">
    Fra: <input type="date" name="from" value="@ViewBag.From"/>
    Til: <input type="date" name="to" value="@ViewBag.To"/>
    <button type="submit">Filter</button>
    <button type="button"
            onclick="window.location='@Url.Action("Index", "AdminBooking")">
        Reset
    </button>
</form>


<table class="table table-dark table-striped">
    <thead>
    <tr>
        <th>Dato</th>
        <th>Fra – Til</th>
        <th>Kunde</th>
        <th>Ønsket kontakt metode</th>
        <th>Størrelse</th>
        <th>Design</th>
        <th>Plassering</th>
        <th>Budjett</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var b in Model)
    {
        <tr data-bs-toggle="collapse" data-bs-target="#details-@b.Id" style="cursor:pointer;">
            <td>@b.SelectedDate.ToString("dd.MM.yyyy")</td>
            <td>@b.SelectedStartTime - @b.SelectedEndTime</td>
            <td>@b.Email<br />@b.Phone</td>
            <td>@(b.PrefferedCM == 1 ? "SMS" : "Email")</td>
            <td>@(b.Size == 1 ? "Small" : b.Size == 2 ? "Medium" : b.Size == 3 ? "Large" : "XL")</td>
            <td>@b.Design</td>
            <td>@b.Placement</td>
            <td>@b.Budget</td>
        </tr>
        
        <tr class="collapse" id="details-@b.Id">
            <td colspan="10" class="bg-dark p-3">
                <strong>Kommentar:</strong> @b.Comment <br />
                
                <strong>Opplastet bilde:</strong><br />
                @if (!string.IsNullOrEmpty(b.ImagePath))
                {
                    <img src="@Url.Content(b.ImagePath)"
                         alt="Referanse bilde"
                         style="max-width: 200px; border-radius: 6px;" />
                }
                else
                {
                    <span>Ingen bilde lastet opp</span>
                }
            </td>
        </tr>
    }

    
    </tbody>
</table>