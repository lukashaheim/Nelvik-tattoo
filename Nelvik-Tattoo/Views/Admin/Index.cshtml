@{
    ViewData["Title"] = "Hei Nikolai";

}

@section FullWidth {
    <div class="admin-bg">
        <div class="container">
            <h1>Hei Nikolai</h1>

            <form asp-area="Identity"
                  asp-page="/Account/Logout"
                  asp-route-returnUrl="/"
                  method="post"
                  class="mb-3">
                <button type="submit" class="btn btn-dark">Logg ut</button>
            </form>

            <p>Hva vil du gjøre idag?</p>

            <div class="admin-actions">
                <a asp-controller="HomeAdmin" asp-action="Index" class="admin-btn">
                    Edit Home Gallery
                </a>
                <a asp-controller="AboutAdmin" asp-action="Index" class="admin-btn">
                    Edit About
                </a>
                <a asp-controller="AdminFaq" asp-action="Index" class="admin-btn">
                    Edit FAQ
                </a>
                <a asp-controller="GalleryAdmin" asp-action="Index" class="admin-btn">
                    Edit Gallery
                </a>
                <a asp-controller="AdminBooking" asp-action="Index" class="admin-btn">
                    See Appointments
                </a>
            </div>
            
        </div>
    </div>
}


