@{
    ViewData["Title"] = "Hei Nikolai";

}

@section Styles {
    <style>
        .admin-bg {
            background-image: url('@Url.Content("~/Images/admin_bg.jpg")');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            min-height: 100vh;
            width: 100%;
        }
    </style>
}

@section FullWidth {
    <div class="admin-bg">
        <div class="container">
            <h1>Hei Nikolai</h1>

            <form asp-area="Identity"
                  asp-page="/Account/Logout"
                  asp-route-returnUrl="/"
                  method="post"
                  class="mb-3">
                <button type="submit" class="btn btn-dark">Logg ut</button>
            </form>

            <p>Hva vil du gjøre idag?</p>

            <div class="admin-actions">
                <a asp-controller="AdminFaq" asp-action="Index" class="admin-btn">
                    Rediger FAQ
                </a>

                <a asp-controller="AboutAdmin" asp-action="Index" class="admin-btn">
                    Rediger i About
                </a>

                <a asp-controller="GalleryAdmin" asp-action="Index" class="admin-btn">
                    Rediger i Galleri
                </a>
            </div>
            
        </div>
    </div>
}


