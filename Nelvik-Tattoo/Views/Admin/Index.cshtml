@{
    ViewData["Title"] = "Admin";

}

@section Styles {
    <style>
        .admin-bg {
            background-image: url('@Url.Content("~/Images/admin_bg.jpg")');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            min-height: 100vh;
            width: 100%;
        }
    </style>
}

@section FullWidth {
    <div class="admin-bg">
        <div class="container">
            <h1>Admin</h1>

            <form asp-area="Identity"
                  asp-page="/Account/Logout"
                  asp-route-returnUrl="/"
                  method="post"
                  class="mb-3">
                <button type="submit" class="btn btn-dark">Logg ut</button>
            </form>

            <p>Velkommen tilbake.</p>

            <a asp-controller="AdminFaq" asp-action="Index" class="btn btn-primary">
                FAQ-admin
            </a>
        </div>
    </div>
}


